# Copy to .env and edit, or just run scripts/setup.sh (it generates a seat name,
# wires this laptop's Dynatrace tenant, and writes this file for you).
# .env is gitignored — never commit real tokens.

# --- seat (this laptop) ----------------------------------------------------
# LANE is this laptop's unique seat name. It namespaces everything, so any
# number of laptops share one or several AWS accounts without colliding: the
# Lambda Web Function (order-rescue-lite-<LANE>), the log group, and the demo
# git branch (demo/<LANE>). There are no seat numbers. setup.sh auto-generates
# a name like "nimble-yak-6fec"; or set your own (lowercase/digits/dashes,
# 2-40 chars, no leading/trailing dash).
LANE=nimble-yak-6fec

# --- model ----------------------------------------------------------------
# bedrock = real Claude on Amazon Bedrock (needs AWS credentials).
# mock    = deterministic fake model, runs with NO credentials. Great first look.
MODEL_MODE=bedrock
AWS_REGION=us-east-1
# Optional: require this account before launching or deploying with AWS credentials.
AWS_EXPECTED_ACCOUNT_ID=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- this laptop's Dynatrace tenant (each laptop uses its own) --------------
# Leave blank to run with no tracing. Mind the %20 after Api-Token — OTEL header
# values are URL-encoded, so a literal space will 401 silently.
#   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://TENANT.live.dynatrace.com/api/v2/otlp/v1/traces
#   OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Api-Token%20dt0c01.XXXXXXXX
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# Delay per backend read, in milliseconds (makes each read visible in the trace).
ORDER_DELAY_MS=400
